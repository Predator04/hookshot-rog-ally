--- a/host/nn_vi.c
+++ b/host/nn_vi.c
@@ -146,6 +146,20 @@ static int fps_max(void) {
     if (!fps_now) fps_refresh();
     return fps_now;
 }
+/* (Ally) HOS_FPS_LOCK=30 (or 20, 15): the display pacing held at that many vsyncs of 60 a frame (2, 3, 4), whatever interval
+   the game asks for: a steady 30 (with 2x frame generation a steady 60 shown). The game's limiter alone (+0xfc, below) did
+   not hold: with variable refresh on, the engine's controller writes it back to 60 every frame (HOS_FPS_LOG: "frame
+   limiter 60" right after the lock, 2026-11-14). Only with the cap at 60; a lock that is no divisor of 60 paces nothing */
+static int lock_interval(void) {
+    static int v = -1;
+    if (v < 0) {
+        const char *e = getenv("HOS_FPS_LOCK");
+        const int l = e ? atoi(e) : 0;
+        v = l >= 15 && l <= 30 && 60 % l == 0 ? 60 / l : 0;
+        if (v) hos_log("vi: frames paced at %d vsyncs of 60 (HOS_FPS_LOCK=%d): a steady %d fps", v, l, 60 / v);
+    }
+    return fps_max() <= 60 ? v : 0;
+}
 static int64_t next_frame_at, window_start, frames_in_window;
 static volatile LONG64 presents;
 int hos_vi_native_interval(Ctx *c, int requested) {
@@ -403,6 +417,17 @@ static void realtime_step(int64_t now) {
             clock_before = game_clock, at_before = now;
         }
         if (target && *limit > 0 && *limit < target) *limit = target;
+        /* (Ally) HOS_FPS_LOCK=<20-59>: the limiter held at that rate, below the console's 60: an even cadence (30 with 2x frame
+           generation is a steady 60 shown) instead of a rate that swings with the scene. The game's own path for frames slower
+           than 60: its limiter sleeps to 1 / +0xfc, and the real-time step below follows the frames' time. Only with the cap at
+           60 (a cap above 60 raises the limiter itself) */
+        static int lock = -1;
+        if (lock < 0) {
+            lock = getenv("HOS_FPS_LOCK") ? atoi(getenv("HOS_FPS_LOCK")) : 0;
+            if (lock < 20 || lock > 59) lock = 0;
+            if (lock) hos_log("vi: frame rate locked at %d (HOS_FPS_LOCK): the game's limiter held there", lock);
+        }
+        if (lock && fps_max() <= 60 && *limit > 0) *limit = lock;
         /* (the cap raises the limiter; it comes down in play: the game's own value back, the one it had when the cap raised it,
            unless the game has written its own since) */
         static int raised, game_limit;
@@ -521,7 +546,7 @@ void hos_vi_native_presented(const int64_t phases[4]) {
     }
     const int64_t now = hos_now_ns();
     realtime_step(now);   /* (first: it reads the menu's cap, fps_refresh) */
-    const int64_t period = 1000000000LL / fps_max() * present_interval;
