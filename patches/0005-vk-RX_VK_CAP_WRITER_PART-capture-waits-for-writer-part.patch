+// (patch 0005: vk_internal.h) only a part already submitted (in part_rec): not wait_recorded_part's 250 ms for one still
+// being recorded or held in a batch, which on the submitting thread's replay nothing would send meanwhile
+bool vk_timeline_wait_part(uint64_t part) {
+    if (!part || !rec_timeline || per_queue_fences_off()) return false;
+    uint64_t seq = 0;
+    {
+        std::lock_guard mk(rec_map_mu);
+        const auto it = part_rec.find(part);
+        if (it == part_rec.end()) return false;
+        seq = it->second;
+    }
+    int ok = 0;
+    wait_rec_seq(seq, 250000000ull, &ok);
+    return ok != 0;
+}
