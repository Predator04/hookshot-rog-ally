+/// (patch 0005) the newest recording part that wrote a late page of the capture still pending (from its mirror: wb_parts;
+/// in place: wb_direct_part, when that in-place write is the page's last write-back), or 0 when a pending page's part is
+/// not known: then the capture waits for the whole submission, as before
+uint64_t late_writer_part(const Capture& c) {
+    const uint64_t done = vk_timeline_completed();
+    uint64_t part = 0;
+    std::lock_guard lk(wb_pages_mu);
+    for (uint32_t i : c.late) {
+        if (i >= c.pages.size()) return 0;
+        const uint64_t pg = c.pages[i], pv = wb_pages.get(pg);
+        if (pv <= done) continue;   // (its write-back done by now)
+        uint64_t pp = wb_parts.get(pg);
+        if (!pp && wb_direct.get(pg) == pv) pp = wb_direct_part.get(pg);
+        if (!pp) return 0;
+        part = std::max(part, pp);
+    }
+    return part;
+}
